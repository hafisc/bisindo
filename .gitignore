# ── Flutter / Dart ────────────────────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
mobile/.dart_tool/
mobile/build/
mobile/.packages
mobile/pubspec.lock
mobile/android/.gradle
mobile/android/local.properties
