# Salin file ini menjadi `.env` (jangan di-commit), lalu jalankan dengan:
#   flutter run --dart-define-from-file=.env
#
# Alamat server prediksi Flask (opsional, default: http://127.0.0.1:5000)
API_BASE_URL=http://127.0.0.1:5000

# Web Client ID dari Firebase Console (OAuth client_type: 3 pada google-services.json).
# Opsional di Android bila google-services.json sudah diproses Gradle plugin,
# wajib diisi bila ingin override via --dart-define.
GOOGLE_SERVER_CLIENT_ID=
