# Salin file ini jadi `.env`, lalu ganti nilainya. Jangan commit file `.env`.

# Kunci rahasia untuk session. Isi dengan teks acak yang panjang.
SECRET_KEY=ganti-dengan-teks-acak-yang-panjang

# Akun untuk masuk ke halaman /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-ini

# Lokasi database. Kosongkan untuk memakai SQLite di web/instance/bisindo.db
DATABASE_URL=

# Lokasi artefak model SVM. Kosongkan untuk memakai ml/models/svm_rbf_bisindo.joblib
# Contoh untuk server: /app/ml/models/svm_rbf_bisindo.joblib
MODEL_PATH=
